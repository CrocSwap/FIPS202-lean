/-! ## SP 800-185 examples -/

def key32 : List UInt8 := (List.range 32).map fun i => (0x40 + i).toUInt8

-- cSHAKE128 sample #1.
#guard cshake128 (hex "00010203") 32 [] (ascii "Email Signature") =
  hex "C1C36925B6409A04F1B504FCBCA9D82B4017277CB5ED2B2065FC1D3814D5AAF5"

